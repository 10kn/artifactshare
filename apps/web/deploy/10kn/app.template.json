{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "${APP_NAME}",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "../workers/app.ts",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 17 * * *", "*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "10kn-share-db",
      "database_id": "${D1_DATABASE_ID}",
      "migrations_dir": "../db/migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "VIEW_DEDUP", "id": "${KV_VIEW_DEDUP_ID}" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "10kn-share-artifacts" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ARTIFACT_LIVE", "class_name": "ArtifactLiveRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArtifactLiveRoom"] }],
  "services": [
    { "binding": "OG_IMAGE_WORKER", "service": "${APP_NAME}-og-image" }
  ],
  "ratelimits": [
    {
      "name": "MCP_RATELIMIT_USER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "MCP_RATELIMIT_WORKSPACE",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "VIEWER_RATELIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "DEFAULT_LOCALE": "en",
    "BETTER_AUTH_URL": "${APP_ORIGIN}",
    "AUTH_ALLOWLIST_DOMAINS": "",
    "AUTH_ALLOWLIST_EMAILS": ""
  }
}
