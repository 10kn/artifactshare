{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "${APP_NAME}-og-image",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "../workers/og-image.ts",
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    { "binding": "SLACK_PREVIEW_FONT_KV", "id": "${KV_OG_FONT_ID}" }
  ],
  "vars": { "APP_ENV": "production", "DEFAULT_LOCALE": "en" }
}
