{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "10kn-share-sandbox",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "../workers/sandbox.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "${SANDBOX_HOST}", "custom_domain": true },
    { "pattern": "*.${SANDBOX_HOST}/*", "zone_name": "${SANDBOX_HOST}" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "10kn-share-db",
      "database_id": "${D1_DATABASE_ID}",
      "migrations_dir": "../db/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "10kn-share-artifacts" }
  ],
  "vars": {
    "APP_ENV": "production",
    "DEFAULT_LOCALE": "en",
    "BETTER_AUTH_URL": "${APP_ORIGIN}"
  }
}
